rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Storage Rules cannot read a named Firestore database. Admin access therefore
    // uses a Firebase Auth custom claim; clients continue to use UID == brandId.
    function isAdmin() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isOwner(brandId) {
      return isSignedIn() && request.auth.uid == brandId;
    }

    function hasBrandAccess(brandId) {
      return isSignedIn()
        && 'teamActive' in request.auth.token
        && 'teamRole' in request.auth.token
        && 'brandIds' in request.auth.token
        && request.auth.token.teamActive == true
        && request.auth.token.teamRole in ['manager', 'social_media']
        && brandId in request.auth.token.brandIds;
    }

    match /brands/{brandId}/media/{mediaId}/{fileName} {
      allow read: if isAdmin() || isOwner(brandId) || hasBrandAccess(brandId);
      allow write: if isAdmin() || hasBrandAccess(brandId);
      allow create, update: if isOwner(brandId)
        && mediaId == 'logos'
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /agency/logo/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
